CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt3600be=y

# 彻底禁用官方开源驱动和造成文件冲突的 wpad 套件
# CONFIG_PACKAGE_kmod-mt76 is not set
# CONFIG_PACKAGE_kmod-mt7996e is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# 联发科 MTK 原厂闭源无线驱动及配套面板
CONFIG_PACKAGE_kmod-mt-wifi=y
CONFIG_PACKAGE_luci-app-mtk=y

# 基础 Web 界面及中文支持
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# 目标功能插件
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_tailscale=y
